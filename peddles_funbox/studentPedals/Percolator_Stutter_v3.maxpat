									"text" : "param knob6_random @min 0. @max 1. @default 0."
								}

							}
, 							{
								"box" : 								{
									"code" : "History dcx(0);\nHistory dcy(0);\nHistory cnt(0);\nHistory ival(48000);\nHistory glen(0);\nHistory ox1(0);\nHistory oy1(0);\nHistory sch(0);\nHistory ff(1);\nHistory odlp(0);\nHistory lpy(0);\n\nx = in1;\nharm = in2;\nbias = in3;\nbal = in4;\nsil = in5;\nspd = in6;\nrnd = in7;\neng = in8;\nmute = in9;\nck = in10;   // toggle 1: clipping  (-1 soft, 0 percolator, +1 wavefold)\ntn = in11;   // toggle 2: tone      (-1 dark, 0 flat, +1 bright)\not = in12;   // toggle 3: octave    (-1 down, 0 off, +1 up)\n\n// ---------- harmonic percolator ----------\n// harm = input gain (drive -> fuzz)\n// bias = smooth -> asymmetric -> starved/gated\ngn = 1 + 49 * harm;\nthr = max(bias - 0.6, 0) * 2.5 * 0.12;\nxd = sign(x) * max(abs(x) - thr, 0);\nboff = bias * 2.5;\n\n// ---------- octave generators ----------\nenv = slide(abs(x), 20, 0.05 * samplerate);\n\n// octave up: rectified signal, DC removed\nocr = abs(xd);\nocb = ocr - ox1 + 0.995 * oy1;\nox1 = ocr;\noy1 = ocb;\n\n// octave down: schmitt trigger -> flip-flop divider -> square wave\n// scaled by the input level and smoothed\nhys = max(0.005, 0.2 * env);\ns0 = sch;\ns1 = s0;\nif (x > hys) {\n    s1 = 1;\n}\nif (x < -hys) {\n    s1 = -1;\n}\nf1 = ff;\nif (s0 <= 0 && s1 > 0) {\n    f1 = -f1;\n}\nsch = s1;\nff = f1;\nodl = odlp + 0.03 * (f1 * env - odlp);\nodlp = odl;\n\npre = xd;\nif (ot > 0.5) {\n    pre = 0.6 * xd + 0.9 * ocb;\n}\nif (ot < -0.5) {\n    pre = 0.6 * xd + 0.9 * odl;\n}\n\n// ---------- clipping ----------\nza = gn * pre + boff;\ndrva = tanh(za) - tanh(boff);\n\nzs = 0.5 * gn * pre + 0.5 * boff;\nhb = 0.5 * boff;\ndrvs = 1.5 * (zs / (1 + abs(zs)) - hb / (1 + abs(hb)));\n\nzf = 0.6 * (1 + gn) * pre;\nfo = bias * 1.25;\ndrvf = sin(zf + fo) - sin(fo);\n\ndrv = drva;\nif (ck < -0.5) {\n    drv = drvs;\n}\nif (ck > 0.5) {\n    drv = drvf;\n}\n\nyb = drv - dcx + 0.995 * dcy;\ndcx = drv;\ndcy = yb;\n\n// ---------- tone ----------\nac = 1 - exp(-6.2831853 * 1500 / samplerate);\nlp1 = lpy + ac * (yb - lpy);\nlpy = lp1;\nyt = yb;\nif (tn < -0.5) {\n    yt = lp1;\n}\nif (tn > 0.5) {\n    yt = yb + 1.2 * (yb - lp1);\n}\n\natt = 1 / (1 + 4 * harm);\nwet = yt * bal * 2 * att;\n\n// ---------- stutter ----------\n// spd = gaps per second (0.5 - 16 Hz)\n// sil = gap length (5 - 500 ms), fully down = no stutter\n// rnd = timing jitter, gap length jitter, skipped gaps\nhz = 0.5 * pow(32, spd);\nnsmp = samplerate / hz;\nc1 = cnt + 1;\ni2 = ival;\ng2 = glen;\nif (c1 >= min(i2, 2 * nsmp)) {\n    c1 = 0;\n    i2 = max(nsmp * (1 + rnd * 0.9 * noise()), 0.003 * samplerate);\n    g2 = 0.005 * samplerate * pow(100, sil) * (1 + rnd * 0.8 * noise());\n    if (noise() * 0.5 + 0.5 < 0.5 * rnd * rnd) {\n        g2 = 0;\n    }\n    if (sil < 0.02) {\n        g2 = 0;\n    }\n    g2 = min(g2, 0.9 * i2);\n}\ncnt = c1;\nival = i2;\nglen = g2;\ngopen = 1;\nif (c1 < g2) {\n    gopen = 0;\n}\nge = slide(gopen, 0.001 * samplerate, 0.001 * samplerate);\n\ny = clip(wet * ge, -1, 1);\n\n// footswitch 2: hold to silence the output (1 ms fade)\nmg = slide(1 - clip(mute, 0, 1), 0.001 * samplerate, 0.001 * samplerate);\nout1 = x;\nif (eng > 0.5) {\n    out1 = y;\n}\nout1 = out1 * mg;\nout2 = eng * ge * mg;\n",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
									"id" : "obj-50",
									"maxclass" : "codebox",
									"numinlets" : 12,
									"numoutlets" : 2,
									"outlettype" : [ "", "" ],
									"patching_rect" : [ 330.0, 100.0, 426.666679382324219, 354.666677236557007 ]
								}

