, 											{
												"box" : 												{
													"code" : "// LFNoise1\n// Params can be set via @freq, @mul, @add or modulated with param inlets\r\n\nParam mul(1.0);\nParam add(0.0);\n\nHistory last_value(0);\nHistory target_value(0);\nHistory phase(0);\r\nfreq = in2; \r\n\nphasor_inc = freq / samplerate;\nphase = phase + phasor_inc;\n\nif(phase >= 1) {\n    phase = phase - 1;\n    last_value = target_value;\n    target_value = noise();\n}\n\ninterp = last_value + (target_value - last_value) * phase;\noutput = interp * mul + add;\n\nout1 = output;",
