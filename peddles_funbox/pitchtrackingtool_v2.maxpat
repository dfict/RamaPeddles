									"patching_rect" : [ 802.0, 746.0, 35.0, 22.0 ],
									"text" : "out 6"
								}

							}
, 							{
								"box" : 								{
									"code" : "// Note matcher (separate gen~), one outlet per target note\n// in1: pitch in Hz        (tracker out3)\n// in2: confidence         (tracker out4)\n// in3: amplitude envelope (tracker out5) - optional, see min_level\n// out1-out5: gate for target1-target5\n// out6: any target hit\n// out7: pitch class 0-11, -1 when ignored\n// out8: DEBUG raw pitch class (ignores all gates)\n// out9: DEBUG cents deviation\n// out10: DEBUG trusted (1 = passed confidence/tuning/level checks)\n//\n// pitch classes: C=0 C#=1 D=2 D#=3 E=4 F=5 F#=6 G=7 G#=8 A=9 A#=10 B=11\n\nParam target1(4, min=-1, max=11);    // E\nParam target2(6, min=-1, max=11);    // F#\nParam target3(9, min=-1, max=11);    // A\nParam target4(11, min=-1, max=11);   // B\nParam target5(2, min=-1, max=11);    // D\n\nParam conf_min(0.9, min=0, max=1);\nParam tolerance_cents(50, min=1, max=50);\nParam min_level(0, min=0, max=1);\n\npitch = in1;\nconf = in2;\nlevel = in3;\n\nvalid_pitch = (pitch > 20) ? 1 : 0;\nmidi = 69 + 12 * log2(max(pitch, 20) / 440);\nnearest = floor(midi + 0.5);\ncents = (midi - nearest) * 100;\npc = nearest - 12 * floor(nearest / 12);\n\nloud_ok = (min_level <= 0) ? 1 : ((level >= min_level) ? 1 : 0);\nconf_ok = (conf >= conf_min) ? 1 : 0;\ntune_ok = (abs(cents) <= tolerance_cents) ? 1 : 0;\ntrusted = valid_pitch * conf_ok * tune_ok * loud_ok;\n\nhit1 = trusted * ((abs(pc - target1) < 0.5) ? 1 : 0);\nhit2 = trusted * ((abs(pc - target2) < 0.5) ? 1 : 0);\nhit3 = trusted * ((abs(pc - target3) < 0.5) ? 1 : 0);\nhit4 = trusted * ((abs(pc - target4) < 0.5) ? 1 : 0);\nhit5 = trusted * ((abs(pc - target5) < 0.5) ? 1 : 0);\n\nout1 = hit1;\nout2 = hit2;\nout3 = hit3;\nout4 = hit4;\nout5 = hit5;\nout6 = max(max(max(hit1, hit2), max(hit3, hit4)), hit5);\nout7 = trusted ? pc : -1;\nout8 = pc;\nout9 = cents;\nout10 = trusted;",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
									"id" : "obj-3",
									"maxclass" : "codebox",
									"numinlets" : 3,
									"numoutlets" : 10,
									"outlettype" : [ "", "", "", "", "", "", "", "", "", "" ],
									"patching_rect" : [ 708.0, 291.0, 624.0, 412.0 ]
								}

							}
, 							{
								"box" : 								{
									"id" : "obj-2",
									"maxclass" : "newobj",
									"numinlets" : 1,
									"numoutlets" : 0,
									"patching_rect" : [ 612.0, 614.0, 35.0, 22.0 ],
