									"patching_rect" : [ 141.0, 607.0, 35.0, 22.0 ],
									"text" : "out 2"
								}

							}
, 							{
								"box" : 								{
									"id" : "obj-7",
									"maxclass" : "newobj",
									"numinlets" : 1,
									"numoutlets" : 0,
									"patching_rect" : [ 283.0, 614.0, 35.0, 22.0 ],
									"text" : "out 3"
								}

							}
, 							{
								"box" : 								{
									"code" : "// Autocorrelation pitch tracker + envelope follower (Gen~ codebox)\n// out1/out2: dry signal\n// out3: detected pitch (Hz, holds last value when unvoiced)\n// out4: confidence (correlation at the peak, holds last value when unvoiced)\n// out5: smooth amplitude envelope (per-sample attack/release follower)\n// out6: block peak (the old stepped peak, updates every 2048 samples)\n\nData audio_buffer(2048, 2);   // ping-pong: one channel records, the other is analyzed\n\nParam min_freq(80, min=20, max=500);\nParam max_freq(1000, min=200, max=5000);\nParam threshold(0.6, min=0, max=1);\nParam attack_ms(5, min=0.1, max=100);\nParam release_ms(120, min=1, max=2000);\n\nHistory write_idx(0);\nHistory write_chan(0);\nHistory read_chan(1);\nHistory processing(0);\nHistory current_lag(0);\nHistory start_lag(1);\nHistory end_lag(1);\nHistory energy0(0);\nHistory energy_lag(0);\nHistory prev_corr(0);\nHistory prev2_corr(0);\nHistory detected_pitch(0);\nHistory confidence(0);\nHistory block_peak(0);\nHistory amp_env(0);\n\nwin = 1448;   // 2048 - 600, so k + lag never runs past the buffer\n\nsig = in1;\n\n// ---------- smooth envelope, every sample ----------\nx = abs(sig);\natt = exp(-1 / (attack_ms * 0.001 * samplerate));\nrel = exp(-1 / (release_ms * 0.001 * samplerate));\ncoef = (x > amp_env) ? att : rel;\namp_env = x + coef * (amp_env - x);\n\n// ---------- record into the current write channel ----------\npoke(audio_buffer, sig, write_idx, write_chan);\nwrite_idx = write_idx + 1;\n\n// ---------- block full: swap channels and set up analysis ----------\nif(write_idx >= 2048) {\n    write_idx = 0;\n    read_chan = write_chan;\n    write_chan = 1 - write_chan;\n\n    // start 2 lags early so the first candidate has real neighbors\n    start_lag = max(floor(samplerate / max_freq) - 2, 1);\n    end_lag = min(ceil(samplerate / min_freq), 600);\n\n    e0 = 0;\n    el = 0;\n    pk = 0;\n    j = 0;\n    while(j < win) {\n        v = peek(audio_buffer, j, read_chan);\n        w = peek(audio_buffer, j + start_lag, read_chan);\n        e0 = e0 + v * v;\n        el = el + w * w;\n        pk = max(pk, abs(v));\n        j = j + 1;\n    }\n    energy0 = e0;\n    energy_lag = el;\n    block_peak = pk;\n\n    current_lag = start_lag;\n    prev_corr = 0;\n    prev2_corr = 0;\n\n    if(e0 > 0.0001) {\n        processing = 1;\n    } else {\n        processing = 0;   // silence: skip the analysis, hold last values\n    }\n}\n\n// ---------- one lag per sample ----------\nif(processing > 0) {\n    lag = current_lag;\n    found = 0;\n    offset = 0;\n\n    c = 0;\n    k = 0;\n    while(k < win) {\n        c = c + peek(audio_buffer, k, read_chan) * peek(audio_buffer, k + lag, read_chan);\n        k = k + 1;\n    }\n\n    // normalize by the first window's energy only (same as the original)\n    c = (energy0 > 0.001) ? c / energy0 : 0;\n\n    // test the PREVIOUS lag as a peak, using the correlation just computed as its right neighbor\n    if(lag >= start_lag + 2) {\n        if(prev_corr > threshold && prev_corr > prev2_corr && prev_corr >= c) {\n            d = prev2_corr - 2 * prev_corr + c;\n            if(abs(d) > 0.000001) {\n                offset = clamp(0.5 * (prev2_corr - c) / d, -0.5, 0.5);\n            }\n            detected_pitch = samplerate / (lag - 1 + offset);\n            confidence = prev_corr;\n            found = 1;\n        }\n    }\n\n    // slide the lag-window energy forward one sample (no extra loop)\n    if(lag < end_lag) {\n        a0 = peek(audio_buffer, lag, read_chan);\n        a1 = peek(audio_buffer, lag + win, read_chan);\n        energy_lag = max(energy_lag - a0 * a0 + a1 * a1, 0);\n    }\n\n    prev2_corr = prev_corr;\n    prev_corr = c;\n    current_lag = lag + 1;\n\n    if(found > 0) {\n        processing = 0;      // first peak wins, stop early\n    } else if(current_lag > end_lag) {\n        processing = 0;      // no peak found: hold last pitch and confidence\n    }\n}\n\nout1 = sig;\nout2 = sig;\nout3 = detected_pitch;\nout4 = confidence;\nout5 = amp_env;\nout6 = block_peak;",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
									"id" : "obj-6",
									"maxclass" : "codebox",
