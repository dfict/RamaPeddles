								}

							}
, 							{
								"box" : 								{
									"code" : "\nParam knob2_blend(0);          // 0 = dry, 1 = fully crushed\nParam knob3_depth(0);  // mapped to bit depth\nParam knob4_rate(0);   // mapped to downsample factor\n\nHistory hold(0);\nHistory counter(0);\n\n// === RUNTIME CODE ============================================\n\n// audio input\nsig = in1;\n\n// Map knob3_depth (0–1) → bit depth 4–16\nbitDepth = mix(4, 16, knob3_depth);\nbitDepth = floor(bitDepth);\n\n// Map knob4_rate (0–1) → downsample factor 1–32\ndownFloat = mix(1, 32, knob4_rate);\ndown = max(1, floor(downFloat));\n\n// Downsampling\ncounter = counter + 1;\ndoSample = (counter >= down);\n\nif (doSample) {\n    hold = sig;\n    counter = 0;\n}\n\n// Bit-depth quantization\nmaxVal = pow(2, bitDepth) - 1;\nquantized = round(hold * maxVal) / maxVal;\n\n// Dry/wet using footswitch sw1\ndry = sig;\nwet = quantized;       // fully crushed\noutSig = mix(dry, wet, knob2_blend); // sw1 = 0 → dry, 1 → wet\n\n// Outputs (Petal: 2 audio outs + 4 LEDs)\nout1 = outSig;  // left\nout2 = outSig;  // right (mono→stereo)\nout3 = knob2_blend;     // LED1 shows effect on/off\nout4 = 0;\nout5 = 0;\nout6 = 0;\n",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
									"id" : "obj-1",
									"maxclass" : "codebox",
									"numinlets" : 1,
									"numoutlets" : 6,
									"outlettype" : [ "", "", "", "", "", "" ],
									"patching_rect" : [ 124.0, 178.0, 581.0, 399.0 ]
								}

							}
 ],
